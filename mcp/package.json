{
  "name": "@fluent-ui/mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Model Context Protocol server exposing Microsoft Fluent 2 (Fluent UI 2.0) tools: component & token lookup, theme generation, Power BI theme + PBIP/PBIR scaffolding, and Power Platform guidance.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fluent-ui-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "data/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
